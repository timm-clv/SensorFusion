<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="drone_sensor_platform">

  <!-- ================================================================= -->
  <!--  BASE LINK (New Platform 19cm x 8cm x 8mm)            -->
  <!-- ================================================================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.19 0.08 0.008"/> 
      </geometry>
      <material name="alu_gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>
  
  <!-- ================================================================= -->
  <!-- EMBEDDED COMPUTER: NVIDIA Jetson Orin Nano     -->
  <!-- ================================================================= -->
  <link name="jetson_link">
    <visual>
      <geometry>
        <box size="0.103 0.0905 0.03477"/>
      </geometry>
      <material name="nvidia_green">
        <color rgba="0.1 0.2 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_jetson" type="fixed">
    <parent link="base_link"/>
    <child link="jetson_link"/>
    <origin xyz="-0.04 0.0 0.021385" rpy="0 0 0"/> 
  </joint>
  
  <!-- ================================================================= -->
  <!-- OPTICAL FLOW: Holybro H-Flow -->
  <!-- ================================================================= -->
  <link name="optical_flow_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.015"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_holybro_flow" type="fixed">
    <parent link="base_link"/>
    <child link="optical_flow_link"/>
    <!-- unchanged platform 
    <origin xyz="0.07 0.0 -0.0115" rpy="${pi} 0 ${-pi/2}"/> -->
    <!-- Spot example -->
    <origin xyz="0.07 0.0 -0.0115" rpy="${pi} 0 ${-pi/2}"/>
  </joint>

  <!-- ================================================================= -->
  <!-- 3. IMU : OliveSense X1 Pro  -->
  <!-- ================================================================= -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.01"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_olive_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.07 0.0 0.009" rpy="0 0 ${pi/2}"/> 
  </joint>
  
  <link name="oliveimu_base_link"/>
  <joint name="imu_to_oliveimu_bridge" type="fixed">
    <parent link="imu_link"/>
    <child link="oliveimu_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </joint>
  
  <!-- ================================================================= -->
  <!-- 4. CAMERA : OliveVision V1 -->
  <!-- ================================================================= -->
  <link name="olivecam_link">
    <visual>
      <geometry>
        <box size="0.038 0.038 0.0383"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_olive_cam" type="fixed">
    <parent link="base_link"/>
    <child link="olivecam_link"/>
    <origin xyz="0.085 0.0 0.049" rpy="${-pi/2} ${-pi/2} 0"/> 
  </joint>

  <link name="olivecam_optical_frame"/>
  <joint name="olivecam_link_to_optical" type="fixed">
    <parent link="olivecam_link"/>
    <child link="olivecam_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <link name="olivecam_imu_frame"/>
  <joint name="olivecam_link_to_imu" type="fixed">
    <parent link="olivecam_link"/>
    <child link="olivecam_imu_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> 
  </joint>

<!-- ================================================================= -->
  <!-- INTEL REALSENSE D435i -->
  <!-- ================================================================= -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />

  <xacro:sensor_d435i parent="base_link" name="d435" use_nominal_extrinsics="true">
    <origin xyz="0.06 0.0 0.049" rpy="0 0 0"/>
  </xacro:sensor_d435i>
  
</robot>
